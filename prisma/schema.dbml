Project prime_reserve {
  database_type: 'PostgreSQL'
  Note: 'Resource Reservation Management System. UUID defaults are generated by Prisma; updated_at values are maintained by Prisma @updatedAt.'
}

Enum UserRole {
  ADMIN
  MEMBER
}

Enum ResourceType {
  ROOM
  STUDIO
  EQUIPMENT
  VEHICLE
}

Enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

Enum NotificationType {
  RESERVATION_CREATED
  RESERVATION_UPDATED
  RESERVATION_CANCELLED
}

Table users {
  id uuid [pk, not null]
  name varchar(100) [not null]
  email varchar(255) [not null]
  department varchar(100)
  job_title varchar(100)
  password_hash varchar(255) [not null]
  role UserRole [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz(3) [not null, default: `now()`]
  updated_at timestamptz(3) [not null, note: 'Maintained by Prisma @updatedAt']

  indexes {
    (email) [unique, name: 'users_email_key']
  }

  Note: 'User accounts and access roles'
}

Table resources {
  id uuid [pk, not null]
  name varchar(100) [not null]
  type ResourceType [not null]
  description varchar(500)
  location varchar(150) [not null]
  capacity int [not null]
  color char(7) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz(3) [not null, default: `now()`]
  updated_at timestamptz(3) [not null, note: 'Maintained by Prisma @updatedAt']

  Note: 'Reservable rooms, studios, equipment, and vehicles'
}

Table booking_settings {
  id int [pk, not null, default: 1]
  restrict_saturday boolean [not null, default: false]
  restrict_sunday boolean [not null, default: false]

  Note: 'Singleton admin settings controlling weekend booking restrictions'
}

Table booking_blocks {
  id uuid [pk, not null]
  date date [not null]
  resource_id uuid
  reason varchar(300)
  created_at timestamptz(3) [not null, default: `now()`]

  indexes {
    (date, resource_id) [name: 'booking_blocks_date_resource_id_idx']
  }

  Note: 'PostgreSQL partial unique indexes: booking_blocks_date_resource_id_key on (date, resource_id) where resource_id is not null; booking_blocks_date_global_key on (date) where resource_id is null.'
}

Table reservations {
  id uuid [pk, not null]
  resource_id uuid [not null]
  user_id uuid [not null]
  title varchar(100) [not null]
  description varchar(500)
  attendees int [not null, default: 1]
  start_at timestamptz(3) [not null]
  end_at timestamptz(3) [not null]
  status ReservationStatus [not null]
  cancelled_at timestamptz(3)
  cancelled_by_id uuid
  cancellation_reason varchar(300)
  created_at timestamptz(3) [not null, default: `now()`]
  updated_at timestamptz(3) [not null, note: 'Maintained by Prisma @updatedAt']

  indexes {
    (resource_id, start_at, end_at) [name: 'reservations_resource_id_start_at_end_at_idx']
    (user_id) [name: 'reservations_user_id_idx']
    (status) [name: 'reservations_status_idx']
  }

  Note: 'Check constraint reservations_end_after_start requires end_at > start_at. PostgreSQL exclusion constraint reservations_no_overlap uses gist on resource_id and the half-open time range [start_at, end_at), only when status is not CANCELLED. Requires btree_gist.'
}

Table notifications {
  id uuid [pk, not null]
  user_id uuid [not null]
  reservation_id uuid
  type NotificationType [not null]
  title varchar(100) [not null]
  message varchar(500) [not null]
  is_read boolean [not null, default: false]
  read_at timestamptz(3)
  created_at timestamptz(3) [not null, default: `now()`]

  indexes {
    (user_id, is_read) [name: 'notifications_user_id_is_read_idx']
  }
}

Ref: reservations.resource_id > resources.id [delete: restrict, update: cascade]
Ref: reservations.user_id > users.id [delete: restrict, update: cascade]
Ref: reservations.cancelled_by_id > users.id [delete: set null, update: cascade]
Ref: booking_blocks.resource_id > resources.id [delete: cascade, update: cascade]
Ref: notifications.user_id > users.id [delete: restrict, update: cascade]
Ref: notifications.reservation_id > reservations.id [delete: set null, update: cascade]